#!/usr/bin/env python3
"""Open an s3:// URI in the AWS S3 web console."""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
from urllib.parse import quote, unquote, urlsplit


DEFAULT_REGION = "eu-west-1"
REGION_PATTERN = re.compile(r"^[a-z0-9-]+$")


def console_url(uri: str) -> str:
    parsed = urlsplit(uri)
    if parsed.scheme.lower() != "s3" or not parsed.netloc:
        raise ValueError("expected an URI in the form s3://bucket/path")
    if parsed.query or parsed.fragment:
        raise ValueError("query strings and fragments are not supported")

    region = os.environ.get("S3_CONSOLE_REGION", DEFAULT_REGION)
    if not REGION_PATTERN.fullmatch(region):
        raise ValueError(f"invalid AWS region: {region!r}")

    bucket = unquote(parsed.netloc)
    key = unquote(parsed.path.lstrip("/"))
    bucket_path = quote(bucket, safe="-._~")
    encoded_key = quote(key, safe="/-._~")

    return (
        f"https://{region}.console.aws.amazon.com/s3/buckets/{bucket_path}"
        f"?region={quote(region, safe='-')}"
        f"&prefix={encoded_key}"
        "&showversions=false"
    )


def main() -> int:
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} s3://bucket/path", file=sys.stderr)
        return 2

    try:
        target = console_url(sys.argv[1])
    except ValueError as error:
        print(f"s3-console: {error}", file=sys.stderr)
        return 2

    opener = shutil.which("xdg-open")
    if opener is None:
        print("s3-console: xdg-open is not installed", file=sys.stderr)
        return 1

    try:
        subprocess.Popen(
            [opener, target],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as error:
        print(f"s3-console: could not open browser: {error}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
